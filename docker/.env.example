# Copier en .env à côté de docker-compose.yml. Ce fichier n'est jamais commité.

# Nom public de l'API et du panel : doit déjà pointer vers cette machine (DNS A ou AAAA).
# Sert au certificat HTTPS (Caddy), à la CA des nœuds et à l'URL d'enrôlement.
KURO_PUBLIC_HOST=panel.example.com

# Mot de passe de la base PostgreSQL locale (service postgres) : openssl rand -hex 24
POSTGRES_PASSWORD=

# Clé des sessions et des jetons de l'API : openssl rand -hex 32. Ne change plus ensuite.
KURO_API_AUTH__SECRET_KEY=

# Version de l'image ghcr.io/kuroctl/kuro-api : une version précise (0.2.1) ou latest.
KURO_VERSION=latest
