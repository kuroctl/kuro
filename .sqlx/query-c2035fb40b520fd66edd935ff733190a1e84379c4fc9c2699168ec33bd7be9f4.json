  "query": "SELECT id, server_id, name, cron, timezone, enabled, only_when_online, next_run_at,\n                    running_since, created_at\n             FROM server_schedules\n             WHERE enabled AND next_run_at <= $1\n             ORDER BY next_run_at\n             LIMIT $2\n             FOR UPDATE SKIP LOCKED",
