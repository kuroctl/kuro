  "query": "SELECT a.id, a.node_id, a.ip, a.port, a.server_id,\n                      s.name AS \"server_name?\", a.port_name, a.created_at\n               FROM allocations a LEFT JOIN servers s ON s.id = a.server_id\n               WHERE a.node_id = $1 AND a.id = $2",
